<Window x:Class="PlaylistMaker.Views.GenerateTagsOneByOneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate ID3 tags - one file at a time" Height="384" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="ProgressText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="Full path (read only, can be copied):" Style="{StaticResource HintText}" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="PathBox" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 Padding="3,2" VerticalContentAlignment="Center" Margin="0,0,0,10"
                 Background="#FFEDEFF2" BorderBrush="{StaticResource PanelBorder}" />

        <TextBlock Grid.Row="3" x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="4" x:Name="ArtistRow" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Artist" />
            <TextBox Grid.Column="1" x:Name="ArtistBox" Padding="3,2" VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <Grid Grid.Row="5" x:Name="AlbumRow" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Album" />
            <TextBox Grid.Column="1" x:Name="AlbumBox" Padding="3,2" VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource PanelBorder}" />
        </Grid>

        <TextBlock Grid.Row="6" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Top"
                   Margin="0,10,0,0"
                   Text="Accept writes the names into every queued track whose file name (and, when you asked for it, whose folder name) contains them, and those tracks leave the queue. Skip file drops this one, Skip folder drops the rest of this file's folder, Skip all files stops asking and writes what you accepted so far. Cancel writes nothing." />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Accept" IsDefault="True" Click="OnAcceptClick" />
            <Button Content="Skip file" Click="OnSkipFileClick" />
            <Button Content="Skip folder" Click="OnSkipFolderClick" />
            <Button Content="Skip all files" Click="OnSkipAllClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
