<Window x:Class="PlaylistMaker.Views.SortPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sort playlist" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sort the tracks of this playlist by:" Margin="0,0,0,8" />

        <ComboBox Grid.Row="1" x:Name="FieldBox" Margin="0,0,0,14">
            <ComboBoxItem Content="Track number (from tags)" />
            <ComboBoxItem Content="File name" />
            <ComboBoxItem Content="Track name" />
            <ComboBoxItem Content="File size" />
            <ComboBoxItem Content="Track length" />
            <ComboBoxItem Content="Album name" />
            <ComboBoxItem Content="Artist name" />
            <ComboBoxItem Content="Shuffle" />
        </ComboBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="AscendingRadio" Content="Ascending" IsChecked="True"
                         GroupName="Direction" Margin="0,0,18,0" />
            <RadioButton x:Name="DescendingRadio" Content="Descending" GroupName="Direction" />
        </StackPanel>

        <TextBlock Grid.Row="3" Style="{StaticResource HintText}" TextWrapping="Wrap"
                   Text="Shuffle ignores the direction and just mixes the order. Ctrl+Z brings the previous order back." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sort" IsDefault="True" Click="OnSortClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
