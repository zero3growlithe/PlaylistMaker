<Window x:Class="PlaylistMaker.Views.GenerateTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate ID3 tags from file names" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid Grid.Row="1" x:Name="HeaderGrid" Margin="0,0,19,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ArtistHeaderColumn" />
                <ColumnDefinition x:Name="AlbumHeaderColumn" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File name (read only, can be copied)" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="1" x:Name="ArtistHeader" Text="Artist" Style="{StaticResource HintText}" Margin="4,0,0,0" />
            <TextBlock Grid.Column="2" x:Name="AlbumHeader" Text="Album" Style="{StaticResource HintText}" Margin="4,0,0,0" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="RowList" HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch" BorderThickness="1" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding ArtistColumnWidth}" />
                            <ColumnDefinition Width="{Binding AlbumColumnWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding FileName, Mode=OneWay}" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" ToolTip="{Binding FolderPath}"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 Background="#FFF2F3F5" BorderBrush="{StaticResource PanelBorder}" />
                        <TextBox Grid.Column="1" Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ArtistVisibility}" Margin="4,0,0,0"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource PanelBorder}" />
                        <TextBox Grid.Column="2" Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding AlbumVisibility}" Margin="4,0,0,0"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource PanelBorder}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="A name typed once is written into every track whose file name contains it, ignoring case. Leave a box empty to skip that track for that tag. Only MP3 and FLAC files are written." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Write tags" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
