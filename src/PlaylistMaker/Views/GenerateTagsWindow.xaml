<Window x:Class="PlaylistMaker.Views.GenerateTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate ID3 tags from file names" Height="620" Width="1180"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Type a search term next to a track: every track whose file name (and, when you asked for it, whose folder name) contains that term gets the artist and album you typed on the same row. Leave the search term empty to fill in just that one track." />

        <Grid Grid.Row="2" x:Name="HeaderGrid" Margin="0,0,19,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SearchTermHeaderColumn" />
                <ColumnDefinition x:Name="ArtistHeaderColumn" />
                <ColumnDefinition x:Name="AlbumHeaderColumn" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="File name (read only, can be copied)" Style="{StaticResource HintText}" />
            <TextBlock Grid.Column="1" x:Name="SearchTermHeader" Text="Search term" Style="{StaticResource HintText}" Margin="4,0,0,0" />
            <TextBlock Grid.Column="2" x:Name="ArtistHeader" Text="Artist" Style="{StaticResource HintText}" Margin="4,0,0,0" />
            <TextBlock Grid.Column="3" x:Name="AlbumHeader" Text="Album" Style="{StaticResource HintText}" Margin="4,0,0,0" />
        </Grid>

        <ListBox Grid.Row="3" x:Name="RowList" HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch" BorderThickness="1" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding FileName, Mode=OneWay}" IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True" ToolTip="{Binding FolderPath}"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 Margin="0,0,4,0"
                                 Background="{DynamicResource InputReadOnlyBackground}" BorderBrush="{DynamicResource PanelBorder}" />
                        <!-- a collapsed box collapses its Auto column, so a hidden column takes no room -->
                        <TextBox Grid.Column="1" Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" ToolTip="Every track whose file name contains this term gets the artist and album from this row. Empty means this file's own name."
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource PanelBorder}" />
                        <TextBox Grid.Column="2" Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ArtistVisibility}" Width="240" Margin="4,0,0,0"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource PanelBorder}" />
                        <TextBox Grid.Column="3" Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding AlbumVisibility}" Width="240" Margin="4,0,0,0"
                                 Padding="3,2" VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource PanelBorder}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="The longest matching search term wins, ignoring case, and a value that is already in the tags is not rewritten. Leave the artist or album box empty to skip that tag for the tracks it matches. Only MP3 and FLAC files are written." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Write tags" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
