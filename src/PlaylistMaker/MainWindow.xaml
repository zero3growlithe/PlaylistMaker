<Window x:Class="PlaylistMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist Maker" Height="780" Width="1320" MinHeight="540" MinWidth="920"
        Background="{StaticResource WindowBackground}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Playlist Maker" FontSize="16" FontWeight="Bold" Margin="0,0,16,0" />
            <CheckBox DockPanel.Dock="Left" x:Name="ShowAllFilesCheckBox" Content="Show all files"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      Checked="OnShowAllFilesChanged" Unchecked="OnShowAllFilesChanged"
                      ToolTip="Off: the tree lists only music files and playlists." />
            <Button DockPanel.Dock="Left" Content="Refresh" Click="OnRefreshClick"
                    ToolTip="Reload the drives and re-check which playlist entries still exist." />
            <TextBlock Style="{StaticResource HintText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Text="Drag music onto a playlist tab. Alt+click a folder arrow to collapse the whole branch." />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ── Explorer ─────────────────────────────────────────────── -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Explorer" Style="{StaticResource PanelHeaderText}" Margin="0" />
                </Border>

                <ListBox x:Name="ExplorerList" SelectionMode="Extended"
                         PreviewKeyDown="OnExplorerKeyDown"
                         PreviewMouseLeftButtonDown="OnExplorerMouseDown"
                         PreviewMouseMove="OnExplorerMouseMove"
                         PreviewMouseRightButtonDown="OnExplorerRightButtonDown"
                         ContextMenuOpening="OnExplorerContextMenuOpening"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding IndentMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ChevronButton}"
                                        Content="{Binding ChevronGlyph}"
                                        Tag="{Binding}"
                                        Visibility="{Binding ExpandButtonVisibility}"
                                        Click="OnChevronClick"
                                        ToolTip="Click to expand. Alt+click to collapse this folder and everything under it." />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- ── Playlist tabs + entries ───────────────────────────────── -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Playlist" Style="{StaticResource PanelHeaderText}"
                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ListBox Grid.Column="1" x:Name="TabStrip" SelectionMode="Single" BorderThickness="0"
                                     MinWidth="0" VerticalAlignment="Center"
                                     Background="Transparent" Padding="0"
                                     SelectionChanged="OnTabSelectionChanged"
                                     PreviewMouseDown="OnTabStripMouseDown"
                                     MouseDoubleClick="OnTabStripDoubleClick"
                                     AllowDrop="True"
                                     DragOver="OnTabStripDragOver" Drop="OnTabStripDrop"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,4,0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="TabBorder" CornerRadius="6,6,0,0"
                                                            BorderThickness="1,1,1,0" Margin="0,0,0,-1"
                                                            BorderBrush="{StaticResource PanelBorder}"
                                                            Background="#FFEDEFF2" Padding="9,4,6,4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background" Value="#FFE1E6EE" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background"
                                                                    Value="{StaticResource PanelBackground}" />
                                                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding HeaderToolTip}">
                                            <TextBlock Text="{Binding DisplayName}" MinWidth="36"
                                                       Visibility="{Binding NameTextVisibility}" />
                                            <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TabRenameBox}"
                                                     Visibility="{Binding EditorVisibility}"
                                                     KeyDown="OnTabRenameKeyDown"
                                                     LostFocus="OnTabRenameLostFocus" />
                                            <Button Content="&#x2715;" Style="{StaticResource TabCloseButton}"
                                                    Tag="{Binding}" Click="OnCloseTabClick"
                                                    ToolTip="Close this playlist (middle click on the tab works too)" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Column="2" Style="{StaticResource TabAddButton}" Content="+"
                                    Click="OnAddTabClick" ToolTip="Add a new playlist tab" />
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Click="OnSaveClick" ToolTip="Ctrl+S - always asks where to save" />
                            <Button Content="Load" Click="OnLoadClick" ToolTip="Replaces the entries of the current tab" />
                            <Button Content="View in Explorer" Click="OnViewInExplorerClick" ToolTip="E" />
                            <Button Content="Undo" Click="OnUndoClick" ToolTip="Ctrl+Z" />
                            <Button Content="Redo" Click="OnRedoClick" ToolTip="Ctrl+Y" />
                            <Button Content="Remove" Click="OnRemoveClick" ToolTip="Delete" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <TextBlock x:Name="PlaylistSummary" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                </Border>

                <ListBox x:Name="PlaylistList" SelectionMode="Extended" AllowDrop="True"
                         DragOver="OnPlaylistDragOver" Drop="OnPlaylistDrop"
                         PreviewMouseLeftButtonDown="OnPlaylistMouseDown"
                         PreviewMouseMove="OnPlaylistMouseMove"
                         PreviewKeyDown="OnPlaylistKeyDown"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="!"
                                        Tag="{Binding}" Click="OnFixMissingClick"
                                        ToolTip="File not found. Click here to fix."
                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="4,0,8,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayFolder}" Style="{StaticResource HintText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource HintText}" Margin="0,8,0,0"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
