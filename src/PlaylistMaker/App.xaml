<Application x:Class="PlaylistMaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Two layers. The first dictionary is a palette (Themes/Light.xaml or Themes/Dark.xaml,
                swapped at run time by Services/ThemeManager.cs); the second holds the control styles,
                which reach the palette only through DynamicResource, so a swap repaints windows that
                are already open.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
