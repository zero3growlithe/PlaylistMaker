<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>PlaylistMaker</AssemblyName>
    <RootNamespace>PlaylistMaker</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <AssemblyTitle>Playlist Maker</AssemblyTitle>
    <Product>Playlist Maker</Product>
    <Description>Build M3U playlists from a tree view of your drives: drag music in, repair broken entries, save portable relative-path playlists.</Description>
  </PropertyGroup>

</Project>
