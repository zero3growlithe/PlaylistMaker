<!--
    Dark palette. Same keys as Light.xaml - the two files are interchangeable, which is what makes
    the theme toggle a dictionary swap. Text stays light on dark surfaces throughout: every key that
    paints a background has a matching text key, so no control can end up light-on-light.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Surfaces ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1B1D21" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF232529" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF3A3E45" />

    <!-- ── Text ────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFE6E8EB" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA1AA" />
    <SolidColorBrush x:Key="SelectionText" Color="#FFF4F6F9" />

    <!-- ── Accents and state ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5B93FF" />
    <SolidColorBrush x:Key="MissingBrush" Color="#FFF0B429" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#FF2E3B52" />
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#FF2A2E34" />

    <!-- ── Buttons and tabs ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FF2C3037" />
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FF353A42" />
    <SolidColorBrush x:Key="ControlPressedBackground" Color="#FF262A30" />
    <SolidColorBrush x:Key="TabBackground" Color="#FF2C3037" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#FF353A42" />

    <!-- ── Inputs, headers, scroll bars, menus ─────────────────────────── -->
    <SolidColorBrush x:Key="InputBackground" Color="#FF1E2024" />
    <SolidColorBrush x:Key="InputReadOnlyBackground" Color="#FF2A2D32" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#FF2A2E34" />
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#FF4A5058" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#FF5F666F" />
    <SolidColorBrush x:Key="MenuBackground" Color="#FF26282D" />
    <SolidColorBrush x:Key="MenuHoverBackground" Color="#FF353A42" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FF2C3037" />

    <!-- SystemColors overrides: without these the stock templates stay light under a dark window. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E2024" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2C3037" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF9AA1AA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2E3B52" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4F6F9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF2A2E34" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF4F6F9" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF26282D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE6E8EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2C3037" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE6E8EB" />

</ResourceDictionary>
